From ff175bf5fa699b3199bcd2169c1a0418a46ba261 Mon Sep 17 00:00:00 2001
From: Daniel Clasen <d.clasen@qvest-digital.com>
Date: Mon, 2 Nov 2026 00:18:15 +0100
Subject: [PATCH 2/4] ice: roll back VF queue bandwidth when applying it fails

Ported from Media Transport Library's "ice: support VF runtime
rate-limit queue reconfiguration" by Dawid Wesierski
(patches/ice_drv/2.6.7/0001, written against Intel's out-of-tree ice).
The in-tree ice_vc_cfg_q_bw() already applies the bandwidth when the
message arrives; it overwrites vf->qs_bw first, though, so a failure
leaves the stored configuration out of step with the hardware. This
restores the previous configuration and reapplies it, as the MTL patch
does.

Signed-off-by: Daniel Clasen <d.clasen@qvest-digital.com>
---
 drivers/net/ethernet/intel/ice/virt/queues.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/intel/ice/virt/queues.c b/drivers/net/ethernet/intel/ice/virt/queues.c
index a82024bf3..b1a5c65ed 100644
--- a/drivers/net/ethernet/intel/ice/virt/queues.c
+++ b/drivers/net/ethernet/intel/ice/virt/queues.c
@@ -595,6 +595,7 @@ int ice_vc_cfg_q_bw(struct ice_vf *vf, u8 *msg)
 	enum virtchnl_status_code v_ret = VIRTCHNL_STATUS_SUCCESS;
 	struct virtchnl_queues_bw_cfg *qbw =
 		(struct virtchnl_queues_bw_cfg *)msg;
+	struct ice_vf_qs_bw *qs_bw_tmp;
 	struct ice_vsi *vsi;
 	u16 i;
 
@@ -649,6 +650,12 @@ int ice_vc_cfg_q_bw(struct ice_vf *vf, u8 *msg)
 		}
 	}
 
+	qs_bw_tmp = kmemdup(vf->qs_bw, sizeof(vf->qs_bw), GFP_KERNEL);
+	if (!qs_bw_tmp) {
+		v_ret = VIRTCHNL_STATUS_ERR_NO_MEMORY;
+		goto err;
+	}
+
 	for (i = 0; i < qbw->num_queues; i++) {
 		vf->qs_bw[i].queue_id = qbw->cfg[i].queue_id;
 		vf->qs_bw[i].peak = qbw->cfg[i].shaper.peak;
@@ -656,8 +663,19 @@ int ice_vc_cfg_q_bw(struct ice_vf *vf, u8 *msg)
 		vf->qs_bw[i].tc = qbw->cfg[i].tc;
 	}
 
-	if (ice_vf_cfg_qs_bw(vf, qbw->num_queues))
+	if (ice_vf_cfg_qs_bw(vf, qbw->num_queues)) {
+		dev_warn(ice_pf_to_dev(vf->pf), "Unable to configure queue bandwidth for VF-%d\n",
+			 vf->vf_id);
+		memcpy(vf->qs_bw, qs_bw_tmp, sizeof(vf->qs_bw));
+
+		if (ice_vf_cfg_qs_bw(vf, qbw->num_queues))
+			dev_warn(ice_pf_to_dev(vf->pf),
+				 "VF-%d BW rollback failed; HW inconsistent until VF reset\n",
+				 vf->vf_id);
 		v_ret = VIRTCHNL_STATUS_ERR_PARAM;
+	}
+
+	kfree(qs_bw_tmp);
 
 err:
 	/* send the response to the VF */
